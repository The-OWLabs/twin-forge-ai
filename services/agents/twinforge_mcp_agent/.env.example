# Copy to .env (git-ignored). ADK reads it when you run `adk web` / `adk run`.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=twin-forge
GOOGLE_CLOUD_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.5-flash
TWINFORGE_MCP_URL=http://localhost:3000/api/mcp
# TWINFORGE_MCP_TOKEN=   # only if the server sets TWINFORGE_MCP_TOKEN
