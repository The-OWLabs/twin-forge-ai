# Deployment Mode: 'local' (offline mock) or 'gcp' (cloud-native)
APP_ENV=local
LOG_LEVEL=INFO
DEBUG=true

# GCP Project Settings
GCP_PROJECT_ID=twinforge-predictive-maintenance
GCP_REGION=asia-southeast1

# Pub/Sub Configuration
PUBSUB_TOPIC_ID=machine-readings
PUBSUB_SUBSCRIPTION_ID=machine-readings-sub
PUBSUB_DEAD_LETTER_TOPIC_ID=machine-readings-dead-letter

# BigQuery Configuration
BQ_DATASET_ID=predictive_maintenance
BQ_READINGS_TABLE=machine_readings
BQ_FEATURES_TABLE=machine_health_features
BQ_PREDICTIONS_TABLE=machine_predictions
BQ_DEAD_LETTER_TABLE=failed_or_invalid_events

# Cloud Storage
GCS_BUCKET_NAME=twinforge-pm-model-artifacts

# Simulator Configuration
SIMULATOR_NUM_MACHINES=20
SIMULATOR_INTERVAL_SECONDS=2.0
SIMULATOR_RANDOM_SEED=42
SIMULATOR_OUTPUT_MODE=local_file  # 'pubsub' or 'local_file'
SIMULATOR_OUTPUT_FILE=data/raw_readings.jsonl

# ML Configuration
MODEL_PATH=ml/artifacts/model.joblib
PREDICTION_HORIZON_HOURS=24
HIGH_RISK_THRESHOLD=0.70
MEDIUM_RISK_THRESHOLD=0.35
ALERT_COOLDOWN_MINUTES=30

# API & Dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501
